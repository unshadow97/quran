{"number":105,"nameArabic":"الفيل","nameSimple":"Al-Fil","nameTranslated":"The Elephant","nameTranslatedMs":"Gajah","revelationType":"Meccan","ayahCount":5,"bismillahPre":true,"pageStart":601,"pageEnd":601,"ayahs":[{"n":1,"g":6189,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَٰبِ ٱلْفِيلِ","juz":30,"page":601,"hizb":240},{"n":2,"g":6190,"text":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍۢ","juz":30,"page":601,"hizb":240},{"n":3,"g":6191,"text":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","juz":30,"page":601,"hizb":240},{"n":4,"g":6192,"text":"تَرْمِيهِم بِحِجَارَةٍۢ مِّن سِجِّيلٍۢ","juz":30,"page":601,"hizb":240},{"n":5,"g":6193,"text":"فَجَعَلَهُمْ كَعَصْفٍۢ مَّأْكُولٍۭ","juz":30,"page":601,"hizb":240}]}