{"number":26,"nameArabic":"الشعراء","nameSimple":"Ash-Shu'ara","nameTranslated":"The Poets","nameTranslatedMs":"Para Penyair","revelationType":"Meccan","ayahCount":227,"bismillahPre":true,"pageStart":367,"pageEnd":376,"ayahs":[{"n":1,"g":2933,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طسٓمٓ","juz":19,"page":367,"hizb":147},{"n":2,"g":2934,"text":"تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ","juz":19,"page":367,"hizb":147},{"n":3,"g":2935,"text":"لَعَلَّكَ بَٰخِعٌۭ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","juz":19,"page":367,"hizb":147},{"n":4,"g":2936,"text":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةًۭ فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ","juz":19,"page":367,"hizb":147},{"n":5,"g":2937,"text":"وَمَا يَأْتِيهِم مِّن ذِكْرٍۢ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","juz":19,"page":367,"hizb":147},{"n":6,"g":2938,"text":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","juz":19,"page":367,"hizb":147},{"n":7,"g":2939,"text":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۢ كَرِيمٍ","juz":19,"page":367,"hizb":147},{"n":8,"g":2940,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","juz":19,"page":367,"hizb":147},{"n":9,"g":2941,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","juz":19,"page":367,"hizb":147},{"n":10,"g":2942,"text":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ","juz":19,"page":367,"hizb":147},{"n":11,"g":2943,"text":"قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ","juz":19,"page":367,"hizb":147},{"n":12,"g":2944,"text":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","juz":19,"page":367,"hizb":147},{"n":13,"g":2945,"text":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَٰرُونَ","juz":19,"page":367,"hizb":147},{"n":14,"g":2946,"text":"وَلَهُمْ عَلَىَّ ذَنۢبٌۭ فَأَخَافُ أَن يَقْتُلُونِ","juz":19,"page":367,"hizb":147},{"n":15,"g":2947,"text":"قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ","juz":19,"page":367,"hizb":147},{"n":16,"g":2948,"text":"فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَٰلَمِينَ","juz":19,"page":367,"hizb":147},{"n":17,"g":2949,"text":"أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":367,"hizb":147},{"n":18,"g":2950,"text":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًۭا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ","juz":19,"page":367,"hizb":147},{"n":19,"g":2951,"text":"وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَٰفِرِينَ","juz":19,"page":367,"hizb":147},{"n":20,"g":2952,"text":"قَالَ فَعَلْتُهَآ إِذًۭا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ","juz":19,"page":368,"hizb":147},{"n":21,"g":2953,"text":"فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْمًۭا وَجَعَلَنِى مِنَ ٱلْمُرْسَلِينَ","juz":19,"page":368,"hizb":147},{"n":22,"g":2954,"text":"وَتِلْكَ نِعْمَةٌۭ تَمُنُّهَا عَلَىَّ أَنْ عَبَّدتَّ بَنِىٓ إِسْرَٰٓءِيلَ","juz":19,"page":368,"hizb":147},{"n":23,"g":2955,"text":"قَالَ فِرْعَوْنُ وَمَا رَبُّ ٱلْعَٰلَمِينَ","juz":19,"page":368,"hizb":147},{"n":24,"g":2956,"text":"قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ","juz":19,"page":368,"hizb":147},{"n":25,"g":2957,"text":"قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَ","juz":19,"page":368,"hizb":147},{"n":26,"g":2958,"text":"قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","juz":19,"page":368,"hizb":147},{"n":27,"g":2959,"text":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِىٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٌۭ","juz":19,"page":368,"hizb":147},{"n":28,"g":2960,"text":"قَالَ رَبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُمْ تَعْقِلُونَ","juz":19,"page":368,"hizb":147},{"n":29,"g":2961,"text":"قَالَ لَئِنِ ٱتَّخَذْتَ إِلَٰهًا غَيْرِى لَأَجْعَلَنَّكَ مِنَ ٱلْمَسْجُونِينَ","juz":19,"page":368,"hizb":147},{"n":30,"g":2962,"text":"قَالَ أَوَلَوْ جِئْتُكَ بِشَىْءٍۢ مُّبِينٍۢ","juz":19,"page":368,"hizb":147},{"n":31,"g":2963,"text":"قَالَ فَأْتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","juz":19,"page":368,"hizb":147},{"n":32,"g":2964,"text":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌۭ مُّبِينٌۭ","juz":19,"page":368,"hizb":147},{"n":33,"g":2965,"text":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّٰظِرِينَ","juz":19,"page":368,"hizb":147},{"n":34,"g":2966,"text":"قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٌۭ","juz":19,"page":368,"hizb":147},{"n":35,"g":2967,"text":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَأْمُرُونَ","juz":19,"page":368,"hizb":147},{"n":36,"g":2968,"text":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَٱبْعَثْ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ","juz":19,"page":368,"hizb":147},{"n":37,"g":2969,"text":"يَأْتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٍۢ","juz":19,"page":368,"hizb":147},{"n":38,"g":2970,"text":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ","juz":19,"page":368,"hizb":147},{"n":39,"g":2971,"text":"وَقِيلَ لِلنَّاسِ هَلْ أَنتُم مُّجْتَمِعُونَ","juz":19,"page":368,"hizb":147},{"n":40,"g":2972,"text":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ هُمُ ٱلْغَٰلِبِينَ","juz":19,"page":369,"hizb":147},{"n":41,"g":2973,"text":"فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالُوا۟ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ","juz":19,"page":369,"hizb":147},{"n":42,"g":2974,"text":"قَالَ نَعَمْ وَإِنَّكُمْ إِذًۭا لَّمِنَ ٱلْمُقَرَّبِينَ","juz":19,"page":369,"hizb":147},{"n":43,"g":2975,"text":"قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ","juz":19,"page":369,"hizb":147},{"n":44,"g":2976,"text":"فَأَلْقَوْا۟ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا۟ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ ٱلْغَٰلِبُونَ","juz":19,"page":369,"hizb":147},{"n":45,"g":2977,"text":"فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","juz":19,"page":369,"hizb":147},{"n":46,"g":2978,"text":"فَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ","juz":19,"page":369,"hizb":147},{"n":47,"g":2979,"text":"قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَٰلَمِينَ","juz":19,"page":369,"hizb":147},{"n":48,"g":2980,"text":"رَبِّ مُوسَىٰ وَهَٰرُونَ","juz":19,"page":369,"hizb":147},{"n":49,"g":2981,"text":"ق