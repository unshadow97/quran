{"number":37,"nameArabic":"الصافات","nameSimple":"As-Saffat","nameTranslated":"Those who set the Ranks","nameTranslatedMs":"Yang Teratur Berbaris","revelationType":"Meccan","ayahCount":182,"bismillahPre":true,"pageStart":446,"pageEnd":452,"ayahs":[{"n":1,"g":3789,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّۭا","juz":23,"page":446,"hizb":178},{"n":2,"g":3790,"text":"فَٱلزَّٰجِرَٰتِ زَجْرًۭا","juz":23,"page":446,"hizb":178},{"n":3,"g":3791,"text":"فَٱلتَّٰلِيَٰتِ ذِكْرًا","juz":23,"page":446,"hizb":178},{"n":4,"g":3792,"text":"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ","juz":23,"page":446,"hizb":178},{"n":5,"g":3793,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ","juz":23,"page":446,"hizb":178},{"n":6,"g":3794,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","juz":23,"page":446,"hizb":178},{"n":7,"g":3795,"text":"وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ","juz":23,"page":446,"hizb":178},{"n":8,"g":3796,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ","juz":23,"page":446,"hizb":178},{"n":9,"g":3797,"text":"دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ","juz":23,"page":446,"hizb":178},{"n":10,"g":3798,"text":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ","juz":23,"page":446,"hizb":178},{"n":11,"g":3799,"text":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ","juz":23,"page":446,"hizb":178},{"n":12,"g":3800,"text":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","juz":23,"page":446,"hizb":178},{"n":13,"g":3801,"text":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","juz":23,"page":446,"hizb":178},{"n":14,"g":3802,"text":"وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ","juz":23,"page":446,"hizb":178},{"n":15,"g":3803,"text":"وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ","juz":23,"page":446,"hizb":178},{"n":16,"g":3804,"text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ","juz":23,"page":446,"hizb":178},{"n":