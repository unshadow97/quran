{"number":68,"nameArabic":"القلم","nameSimple":"Al-Qalam","nameTranslated":"The Pen","nameTranslatedMs":"Pena / Kalam","revelationType":"Meccan","ayahCount":52,"bismillahPre":true,"pageStart":564,"pageEnd":566,"ayahs":[{"n":1,"g":5272,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","juz":29,"page":564,"hizb":226},{"n":2,"g":5273,"text":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ","juz":29,"page":564,"hizb":226},{"n":3,"g":5274,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ","juz":29,"page":564,"hizb":226},{"n":4,"g":5275,"text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ","juz":29,"page":564,"hizb":226},{"n":5,"g":5276,"text":"فَسَتُبْصِرُ وَيُبْصِرُونَ","juz":29,"page":564,"hizb":226},{"n":6,"g":5277,"text":"بِأَييِّكُمُ ٱلْمَفْتُونُ","juz":29,"page":564,"hizb":226},{"n":7,"g":5278,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","juz":29,"page":564,"hizb":226},{"n":8,"g":5279,"text":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","juz":29,"page":564,"hizb":226},{"n":9,"g":5280,"text":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","juz":29,"page":564,"hizb":226},{"n":10,"g":5281,"text":"وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ","juz":29,"page":564,"hizb":226},{"n":11,"g":5282,"text":"هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ","juz":29,"page":564,"hizb":226},{"n":12,"g":5283,"text":"مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","juz":29,"page":564,"hizb":226},{"n":13,"g":5284,"text":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","juz":29,"page":564,"hizb":226},{"n":14,"g":5285,"text":"أَن كَانَ ذَا مَالٍۢ وَبَنِينَ","juz":29,"page":564,"hizb":226},{"n":15,"g":5286,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","juz":29,"page":564,"hizb":226},{"n":16,"g":5287,"text":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","juz":29,"page":565,"hizb":226},{"n":17,"g":5288,"text":"إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","juz":29,"page":565,"hizb":226},{"n":18,"g":5289,"text":"وَلَا يَسْتَثْنُونَ","juz":29,"page":565,"hizb":226},{"n":19,"g":5290,"text":"فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","juz":29,"page":565,"hizb":226},{"n":20,"g":5291,"text":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","juz":29,"page":565,"hizb":226},{"n":21,"g":5292,"text":"فَتَنَادَوْا۟ مُصْبِحِينَ","juz":29,"page":565,"hizb":226},{"n":22,"g":5293,"text":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ","juz":29,"page":565,"hizb":226},{"n":23,"g":5294,"text":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ","juz":29,"page":565,"hizb":226},{"n":24,"g":5295,"text":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ","juz":29,"page":565,"hizb":226},{"n":25,"g":5296,"text":"وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ","juz":29,"page":565,"hizb":226},{"n":26,"g":5297,"text":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","juz":29,"page":565,"hizb":226},{"n":27,"g":5298,"text":"بَلْ نَحْنُ مَحْرُومُونَ","juz":29,"page":565,"hizb":226},{"n":28,"g":5299,"text":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","juz":29,"page":565,"hizb":226},{"n":29,"g":5300,"text":"قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ","juz":29,"page":565,"hizb":226},{"n":30,"g":5301,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ","juz":29,"page":565,"hizb":226},{"n":31,"g":5302,"text":"قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ","juz":29,"page":565,"hizb":226},{"n":32,"g":5303,"text":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","juz":29,"page":565,"hizb":226},{"n":33,"g":5304,"text":"كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ","juz":29,"page":565,"hizb":226},{"n":34,"g":5305,"text":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ","juz":29,"page":565,"hizb":226},{"n":35,"g":5306,"text":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","juz":29,"page":565,"hizb":226},{"n":36,"g":5307,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","juz":29,"page":565,"hizb":226},{"n":37,"g":5308,"text":"أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ","juz":29,"page":565,"hizb":226},{"n":38,"g":5309,"text":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","juz":29,"page":565,"hizb":226},{"n":39,"g":5310,"text":"أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","juz":29,"page":565,"hizb":226},{"n":40,"g":5311,"text":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","juz":29,"page":565,"hizb":226},{"n":41,"g":5312,"text":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ","juz":29,"page":565,"hizb":226},{"n":42,"g":5313,"text":"يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","juz":29,"page":565,"hizb":226},{"n":43,"g":5314,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ","juz":29,"page":566,"hizb":226},{"n":44,"g":5315,"text":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","juz":29,"page":566,"hizb":226},{"n":45,"g":5316,"text":"وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ","juz":29,"page":566,"hizb":226},{"n":46,"g":5317,"text":"أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ","juz":29,"page":566,"hizb":226},{"n":47,"g":5318,"text":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","juz":29,"page":566,"hizb":226},{"n":48,"g":5319,"text":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ","juz":29,"page":566,"hizb":226},{"n":49,"g":5320,"text":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ","juz":29,"page":566,"hizb":226},{"n":50,"g":5321,"text":"فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ","juz":29,"page":566,"hizb":226},{"n":51,"g":5322,"text":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ","juz":29,"page":566,"hizb":226},{"n":52,"g":5323,"text":"وَمَا هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ","juz":29,"page":566,"hizb":226}]}