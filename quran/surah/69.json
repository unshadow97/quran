{"number":69,"nameArabic":"الحاقة","nameSimple":"Al-Haqqah","nameTranslated":"The Reality","nameTranslatedMs":"Keadaan Sebenar / Hari Kiamat","revelationType":"Meccan","ayahCount":52,"bismillahPre":true,"pageStart":566,"pageEnd":568,"ayahs":[{"n":1,"g":5324,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ","juz":29,"page":566,"hizb":227},{"n":2,"g":5325,"text":"مَا ٱلْحَآقَّةُ","juz":29,"page":566,"hizb":227},{"n":3,"g":5326,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","juz":29,"page":566,"hizb":227},{"n":4,"g":5327,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","juz":29,"page":566,"hizb":227},{"n":5,"g":5328,"text":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","juz":29,"page":566,"hizb":227},{"n":6,"g":5329,"text":"وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ","juz":29,"page":566,"hizb":227},{"n":7,"g":5330,"text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ","juz":29,"page":566,"hizb":227},{"n":8,"g":5331,"text":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ","juz":29,"page":566,"hizb":227},{"n":9,"g":5332,"text":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","juz":29,"page":567,"hizb":227},{"n":10,"g":5333,"text":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً","juz":29,"page":567,"hizb":227},{"n":11,"g":5334,"text":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","juz":29,"page":567,"hizb":227},{"n":12,"g":5335,"text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ","juz":29,"page":567,"hizb":227},{"n":13,"g":5336,"text":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ","juz":29,"page":567,"hizb":227},{"n":14,"g":5337,"text":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ","juz":29,"page":567,"hizb":227},{"n":15,"g":5338,"text":"فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ","juz":29,"page":567,"hizb":227},{"n":16,"g":5339,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ","juz":29,"page":567,"hizb":227},{"n":17,"g":5340,"text":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ","juz":29,"page":567,"hizb":227},{"n":18,"g":5341,"text":"يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ","juz":29,"page":567,"hizb":227},{"n":19,"g":5342,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ","juz":29,"page":567,"hizb":227},{"n":20,"g":5343,"text":"إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ","juz":29,"page":567,"hizb":227},{"n":21,"g":5344,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","juz":29,"page":567,"hizb":227},{"n":22,"g":5345,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","juz":29,"page":567,"hizb":227},{"n":23,"g":5346,"text":"قُطُوفُهَا دَانِيَةٌۭ","juz":29,"page":567,"hizb":227},{"n":24,"g":5347,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","juz":29,"page":567,"hizb":227},{"n":25,"g":5348,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ","juz":29,"page":567,"hizb":227},{"n":26,"g":5349,"text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","juz":29,"page":567,"hizb":227},{"n":27,"g":5350,"text":"يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","juz":29,"page":567,"hizb":227},{"n":28,"g":5351,"text":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ","juz":29,"page":567,"hizb":227},{"n":29,"g":5352,"text":"هَلَكَ عَنِّى سُلْطَٰنِيَهْ","juz":29,"page":567,"hizb":227},{"n":30,"g":5353,"text":"خُذُوهُ فَغُلُّوهُ","juz":29,"page":567,"hizb":227},{"n":31,"g":5354,"text":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","juz":29,"page":567,"hizb":227},{"n":32,"g":5355,"text":"ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ","juz":29,"page":567,"hizb":227},{"n":33,"g":5356,"text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","juz":29,"page":567,"hizb":227},{"n":34,"g":5357,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":29,"page":567,"hizb":227},{"n":35,"g":5358,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ","juz":29,"page":568,"hizb":227},{"n":36,"g":5359,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ","juz":29,"page":568,"hizb":227},{"n":37,"g":5360,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ","juz":29,"page":568,"hizb":227},{"n":38,"g":5361,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","juz":29,"page":568,"hizb":227},{"n":39,"g":5362,"text":"وَمَا لَا تُبْصِرُونَ","juz":29,"page":568,"hizb":227},{"n":40,"g":5363,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ","juz":29,"page":568,"hizb":227},{"n":41,"g":5364,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ","juz":29,"page":568,"hizb":227},{"n":42,"g":5365,"text":"وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ","juz":29,"page":568,"hizb":227},{"n":43,"g":5366,"text":"تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ","juz":29,"page":568,"hizb":227},{"n":44,"g":5367,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","juz":29,"page":568,"hizb":227},{"n":45,"g":5368,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","juz":29,"page":568,"hizb":227},{"n":46,"g":5369,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","juz":29,"page":568,"hizb":227},{"n":47,"g":5370,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ","juz":29,"page":568,"hizb":227},{"n":48,"g":5371,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ","juz":29,"page":568,"hizb":227},{"n":49,"g":5372,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","juz":29,"page":568,"hizb":227},{"n":50,"g":5373,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ","juz":29,"page":568,"hizb":227},{"n":51,"g":5374,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","juz":29,"page":568,"hizb":227},{"n":52,"g":5375,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","juz":29,"page":568,"hizb":227}]}