{"number":75,"nameArabic":"القيامة","nameSimple":"Al-Qiyamah","nameTranslated":"The Resurrection","nameTranslatedMs":"Hari Kebangkitan / Kiamat","revelationType":"Meccan","ayahCount":40,"bismillahPre":true,"pageStart":577,"pageEnd":578,"ayahs":[{"n":1,"g":5552,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","juz":29,"page":577,"hizb":231},{"n":2,"g":5553,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","juz":29,"page":577,"hizb":231},{"n":3,"g":5554,"text":"أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","juz":29,"page":577,"hizb":231},{"n":4,"g":5555,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","juz":29,"page":577,"hizb":231},{"n":5,"g":5556,"text":"بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ","juz":29,"page":577,"hizb":231},{"n":6,"g":5557,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ","juz":29,"page":577,"hizb":231},{"n":7,"g":5558,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","juz":29,"page":577,"hizb":231},{"n":8,"g":5559,"text":"وَخَسَفَ ٱلْقَمَرُ","juz":29,"page":577,"hizb":231},{"n":9,"g":5560,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","juz":29,"page":577,"hizb":231},{"n":10,"g":5561,"text":"يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","juz":29,"page":577,"hizb":231},{"n":11,"g":5562,"text":"كَلَّا لَا وَزَرَ","juz":29,"page":577,"hizb":231},{"n":12,"g":5563,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","juz":29,"page":577,"hizb":231},{"n":13,"g":5564,"text":"يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","juz":29,"page":577,"hizb":231},{"n":14,"g":5565,"text":"بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ","juz":29,"page":577,"hizb":231},{"n":15,"g":5566,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","juz":29,"page":577,"hizb":231},{"n":16,"g":5567,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","juz":29,"page":577,"hizb":231},{"n":17,"g":5568,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","juz":29,"page":577,"hizb":231},{"n":18,"g":5569,"text":"فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَ