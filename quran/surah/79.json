"hizb":233},{"n":41,"g":5753,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","juz":30,"page":584,"hizb":233},{"n":42,"g":5754,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","juz":30,"page":584,"hizb":233},{"n":43,"g":5755,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","juz":30,"page":584,"hizb":233},{"n":44,"g":5756,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","juz":30,"page":584,"hizb":233},{"n":45,"g":5757,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","juz":30,"page":584,"hizb":233},{"n":46,"g":5758,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","juz":30,"page":584,"hizb":233}]}