{"number":83,"nameArabic":"المطففين","nameSimple":"Al-Mutaffifin","nameTranslated":"The Defrauding","nameTranslatedMs":"Golongan yang Curang","revelationType":"Meccan","ayahCount":36,"bismillahPre":true,"pageStart":587,"pageEnd":589,"ayahs":[{"n":1,"g":5849,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ","juz":30,"page":587,"hizb":235},{"n":2,"g":5850,"text":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","juz":30,"page":587,"hizb":235},{"n":3,"g":5851,"text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","juz":30,"page":587,"hizb":235},{"n":4,"g":5852,"text":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","juz":30,"page":587,"hizb":235},{"n":5,"g":5853,"text":"لِيَوْمٍ عَظِيمٍۢ","juz":30,"page":587,"hizb":235},{"n":6,"g":5854,"text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","juz":30,"page":587,"hizb":235},{"n":7,"g":5855,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","juz":30,"page":588,"hizb":235},{"n":8,"g":5856,"text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","juz":30,"page":588,"hizb":235},{"n":9,"g":5857,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","juz":30,"page":588,"hizb":235},{"n":10,"g":5858,"text":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","juz":30,"page":588,"hizb":235},{"n":11,"g":5859,"text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","juz":30,"page":588,"hizb":235},{"n":12,"g":5860,"text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","juz":30,"page":588,"hizb":235},{"n":13,"g":5861,"text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","juz":30,"page":588,"hizb":235},{"n":14,"g":5862,"text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","juz":30,"page":588,"hizb":235},{"n":15,"g":5863,"text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","juz":30,"page":588,"hizb":235},{"n":16,"g":5864,"text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","juz":30,"page":588,"hizb":235},{"n":17,"g":5865,"text":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","juz":30,"page":588,"hizb":235},{"n":18,"g":5866,"text":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","juz":30,"page":588,"hizb":235},{"n":19,"g":5867,"text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","juz":30,"page":588,"hizb":235},{"n":20,"g":5868,"text":"كِتَٰبٌۭ مَّرْقُومٌۭ","juz":30,"page":588,"hizb":235},{"n":21,"g":5869,"text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","juz":30,"page":588,"hizb":235},{"n":22,"g":5870,"text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","juz":30,"page":588,"hizb":235},{"n":23,"g":5871,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","juz":30,"page":588,"hizb":235},{"n":24,"g":5872,"text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","juz":30,"page":588,"hizb":235},{"n":25,"g":5873,"text":"يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ","juz":30,"page":588,"hizb":235},{"n":26,"g":5874,"text":"خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ","juz":30,"page":588,"hizb":235},{"n":27,"g":5875,"text":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","juz":30,"page":588,"hizb":235},{"n":28,"g":5876,"text":"عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","juz":30,"page":588,"hizb":235},{"n":29,"g":5877,"text":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","juz":30,"page":588,"hizb":235},{"n":30,"g":5878,"text":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","juz":30,"page":588,"hizb":235},{"n":31,"g":5879,"text":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","juz":30,"page":588,"hizb":235},{"n":32,"g":5880,"text":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ","juz":30,"page":588,"hizb":235},{"n":33,"g":5881,"text":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ","juz":30,"page":588,"hizb":235},{"n":34,"g":5882,"text":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","juz":30,"page":588,"hizb":235},{"n":35,"g":5883,"text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","juz":30,"page":589,"hizb":235},{"n":36,"g":5884,"text":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","juz":30,"page":589,"hizb":235}]}