{"number":85,"nameArabic":"البروج","nameSimple":"Al-Buruj","nameTranslated":"The Mansions of the Stars","nameTranslatedMs":"Gugusan Bintang","revelationType":"Meccan","ayahCount":22,"bismillahPre":true,"pageStart":590,"pageEnd":590,"ayahs":[{"n":1,"g":5910,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","juz":30,"page":590,"hizb":236},{"n":2,"g":5911,"text":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","juz":30,"page":590,"hizb":236},{"n":3,"g":5912,"text":"وَشَاهِدٍۢ وَمَشْهُودٍۢ","juz":30,"page":590,"hizb":236},{"n":4,"g":5913,"text":"قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ","juz":30,"page":590,"hizb":236},{"n":5,"g":5914,"text":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","juz":30,"page":590,"hizb":236},{"n":6,"g":5915,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌۭ","juz":30,"page":590,"hizb":236},{"n":7,"g":5916,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ","juz":30,"page":590,"hizb":236},{"n":8,"g":5917,"text":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","juz":30,"page":590,"hizb":236},{"n":9,"g":5918,"text":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ","juz":30,"page":590,"hizb":236},{"n":10,"g":5919,"text":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","juz":30,"page":590,"hizb":236},{"n":11,"g":5920,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","juz":30,"page":590,"hizb":236},{"n":12,"g":5921,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","juz":30,"page":590,"hizb":236},{"n":13,"g":5922,"text":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","juz":30,"page":590,"hizb":236},{"n":14,"g":5923,"text":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","juz":30,"page":590,"hizb":236},{"n":15,"g":5924,"text":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","juz":30,"page":590,"hizb":236},{"n":16,"g":5925,"text":"فَعَّالٌۭ لِّمَا يُرِيدُ","juz":30,"page":590,"hizb":23