{"number":86,"nameArabic":"الطارق","nameSimple":"At-Tariq","nameTranslated":"The Nightcommer","nameTranslatedMs":"Pengunjung Malam","revelationType":"Meccan","ayahCount":17,"bismillahPre":true,"pageStart":591,"pageEnd":591,"ayahs":[{"n":1,"g":5932,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","juz":30,"page":591,"hizb":236},{"n":2,"g":5933,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","juz":30,"page":591,"hizb":236},{"n":3,"g":5934,"text":"ٱلنَّجْمُ ٱلثَّاقِبُ","juz":30,"page":591,"hizb":236},{"n":4,"g":5935,"text":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","juz":30,"page":591,"hizb":236},{"n":5,"g":5936,"text":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","juz":30,"page":591,"hizb":236},{"n":6,"g":5937,"text":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","juz":30,"page":591,"hizb":236},{"n":7,"g":5938,"text":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","juz":30,"page":591,"hizb":236},{"n":8,"g":5939,"text":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","juz":30,"page":591,"hizb":236},{"n":9,"g":5940,"text":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","juz":30,"page":591,"hizb":236},{"n":10,"g":5941,"text":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","juz":30,"page":591,"hizb":236},{"n":11,"g":5942,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","juz":30,"page":591,"hizb":236},{"n":12,"g":5943,"text":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","juz":30,"page":591,"hizb":236},{"n":13,"g":5944,"text":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","juz":30,"page":591,"hizb":236},{"n":14,"g":5945,"text":"وَمَا هُوَ بِٱلْهَزْلِ","juz":30,"page":591,"hizb":236},{"n":15,"g":5946,"text":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","juz":30,"page":591,"hizb":236},{"n":16,"g":5947,"text":"وَأَكِيدُ كَيْدًۭا","juz":30,"page":591,"hizb":236},{"n":17,"g":5948,"text":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","juz":30,"page":591,"hizb":236}]}