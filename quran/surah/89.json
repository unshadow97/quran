{"number":89,"nameArabic":"الفجر","nameSimple":"Al-Fajr","nameTranslated":"The Dawn","nameTranslatedMs":"Fajar / Sinar Mentari","revelationType":"Meccan","ayahCount":30,"bismillahPre":true,"pageStart":593,"pageEnd":594,"ayahs":[{"n":1,"g":5994,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ","juz":30,"page":593,"hizb":237},{"n":2,"g":5995,"text":"وَلَيَالٍ عَشْرٍۢ","juz":30,"page":593,"hizb":237},{"n":3,"g":5996,"text":"وَٱلشَّفْعِ وَٱلْوَتْرِ","juz":30,"page":593,"hizb":237},{"n":4,"g":5997,"text":"وَٱلَّيْلِ إِذَا يَسْرِ","juz":30,"page":593,"hizb":237},{"n":5,"g":5998,"text":"هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ","juz":30,"page":593,"hizb":237},{"n":6,"g":5999,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","juz":30,"page":593,"hizb":237},{"n":7,"g":6000,"text":"إِرَمَ ذَاتِ ٱلْعِمَادِ","juz":30,"page":593,"hizb":237},{"n":8,"g":6001,"text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ","juz":30,"page":593,"hizb":237},{"n":9,"g":6002,"text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","juz":30,"page":593,"hizb":237},{"n":10,"g":6003,"text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","juz":30,"page":593,"hizb":237},{"n":11,"g":6004,"text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ","juz":30,"page":593,"hizb":237},{"n":12,"g":6005,"text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","juz":30,"page":593,"hizb":237},{"n":13,"g":6006,"text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","juz":30,"page":593,"hizb":237},{"n":14,"g":6007,"text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","juz":30,"page":593,"hizb":237},{"n":15,"g":6008,"text":"فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","juz":30,"page":593,"hizb":237},{"n":16,"g":6009,"text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ","juz":30,"page":593,"hizb":237},{"n":17,"g":6010,"text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","juz":30,"page":593,"hizb":237},{"n":18,"g":6011,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz":30,"page":593,"hizb":237},{"n":19,"g":6012,"text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا","juz":30,"page":593,"hizb":237},{"n":20,"g":6013,"text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا","juz":30,"page":593,"hizb":237},{"n":21,"g":6014,"text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا","juz":30,"page":593,"hizb":237},{"n":22,"g":6015,"text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا","juz":30,"page":593,"hizb":237},{"n":23,"g":6016,"text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","juz":30,"page":593,"hizb":237},{"n":24,"g":6017,"text":"يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","juz":30,"page":594,"hizb":237},{"n":25,"g":6018,"text":"فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ","juz":30,"page":594,"hizb":237},{"n":26,"g":6019,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ","juz":30,"page":594,"hizb":237},{"n":27,"g":6020,"text":"يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","juz":30,"page":594,"hizb":237},{"n":28,"g":6021,"text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ","juz":30,"page":594,"hizb":237},{"n":29,"g":6022,"text":"فَٱدْخُلِى فِى عِبَٰدِى","juz":30,"page":594,"hizb":237},{"n":30,"g":6023,"text":"وَٱدْخُلِى جَنَّتِى","juz":30,"page":594,"hizb":237}]}