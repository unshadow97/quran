{"number":97,"nameArabic":"القدر","nameSimple":"Al-Qadr","nameTranslated":"The Power","nameTranslatedMs":"Kemuliaan","revelationType":"Meccan","ayahCount":5,"bismillahPre":true,"pageStart":598,"pageEnd":598,"ayahs":[{"n":1,"g":6126,"text":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","juz":30,"page":598,"hizb":239},{"n":2,"g":6127,"text":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","juz":30,"page":598,"hizb":239},{"n":3,"g":6128,"text":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌۭ مِّنْ أَلْفِ شَهْرٍۢ","juz":30,"page":598,"hizb":239},{"n":4,"g":6129,"text":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍۢ","juz":30,"page":598,"hizb":239},{"n":5,"g":6130,"text":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","juz":30,"page":598,"hizb":239}]}