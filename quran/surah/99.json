{"number":99,"nameArabic":"الزلزلة","nameSimple":"Az-Zalzalah","nameTranslated":"The Earthquake","nameTranslatedMs":"Kegoncangan","revelationType":"Medinan","ayahCount":8,"bismillahPre":true,"pageStart":599,"pageEnd":599,"ayahs":[{"n":1,"g":6139,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","juz":30,"page":599,"hizb":239},{"n":2,"g":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","juz":30,"page":599,"hizb":239},{"n":3,"g":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","juz":30,"page":599,"hizb":239},{"n":4,"g":6142,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","juz":30,"page":599,"hizb":239},{"n":5,"g":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","juz":30,"page":599,"hizb":239},{"n":6,"g":6144,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","juz":30,"page":599,"hizb":239},{"n":7,"g":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","juz":30,"page":599,"hizb":239},{"n":8,"g":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","juz":30,"page":599,"hizb":239}]}